# URL base de la API de NestJS (incluye el prefijo /api).
VITE_API_URL="http://localhost:3000/api"

# ───────── Clerk (autenticación) ─────────
# Publishable key de Clerk (Dashboard -> API Keys, empieza con pk_test_ / pk_live_).
# - Si la completás: la app exige login (toda la app queda protegida).
# - Si la dejás vacía: la app corre SIN auth (modo dev). En ese caso, el backend
#   debe tener AUTH_DISABLED="true".
VITE_CLERK_PUBLISHABLE_KEY=""

# ── Etiquetas QR ──
# La dirección con la que se arman los códigos QR de los equipos.
#
# Existe porque la etiqueta se pega en una máquina y se escanea desde un
# celular: si se imprime desde el entorno local, el QR queda apuntando a
# http://localhost:5173, que en el celular no es ningún lado, y eso no se
# descubre hasta tener las etiquetas pegadas.
#
# Si se deja vacía, se usa la dirección desde la que se está entrando al
# sistema, que es la correcta al imprimir desde el sistema publicado.
VITE_URL_PUBLICA=
